<template>
  <scroll class="page">
    <div class="top-space"></div>
    <text class="title">האפליקציות שלי</text>
    <div for="item in items" class="item" on:click="open(item.pkg)">
      <text class="label">{{item.label}}</text>
      <image class="icon" src="{{item.icon}}"/>
    </div>
    <text if="{{message}}" class="message">{{message}}</text>
    <div class="bottom-space"></div>
  </scroll>
</template>

<style>
  .page {
    width: 466px;
    height: 466px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .top-space {
    width: 10px;
    height: 44px;
  }

  .bottom-space {
    width: 10px;
    height: 70px;
  }

  .title {
    width: 320px;
    font-size: 32px;
    color: #58c8ea;
    text-align: center;
    margin-bottom: 14px;
  }

  .item {
    width: 376px;
    height: 92px;
    margin-bottom: 12px;
    border-radius: 46px;
    background-color: #1a2030;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 0 12px;
  }

  .label {
    font-size: 30px;
    color: #ffffff;
    margin-right: 16px;
  }

  .icon {
    width: 68px;
    height: 68px;
  }

  .message {
    width: 330px;
    font-size: 24px;
    color: #ff9a8a;
    text-align: center;
  }
</style>

<script>
  import launch from '@system.launch'

  const ITEMS = [
    { pkg: 'com.abaye.music', label: 'מוזיקה', icon: '/assets/music.png' },
    { pkg: 'com.abaye.reader', label: 'קורא טקסטים', icon: '/assets/reader.png' },
    { pkg: 'com.abaye.whosewatch', label: 'השעון שייך ל...', icon: '/assets/whose.png' }
  ]

  export default {
    data: {
      items: ITEMS,
      message: ''
    },
    busy: false,
    onShow() {
      this.busy = false
      this.message = ''
    },
    async open(pkg) {
      if (this.busy) return
      this.busy = true
      this.message = ''
      try {
        const result = await launch.launch(pkg)
        console.info('[my-apps] launch ' + pkg + ': ' + result)
        if (result === false) this.message = 'האפליקציה לא נפתחה. ודא שהיא מותקנת.'
      } catch (e) {
        console.error('[my-apps] launch ' + pkg + ' failed: ' + e)
        this.message = 'האפליקציה לא נפתחה. ודא שהיא מותקנת.'
      }
      this.busy = false
    }
  }
</script>